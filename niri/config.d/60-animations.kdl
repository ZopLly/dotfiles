animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // Включаем пружинные анимации с приятным откликом
    window-open {
        spring damping-ratio=0.5 stiffness=600 epsilon=0.001
    }
    window-close {
        spring damping-ratio=0.9 stiffness=1000 epsilon=0.001
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=600 epsilon=0.001
    }
    window-movement {
        spring damping-ratio=0.8 stiffness=700 epsilon=0.001
    }
    slowdown 1.2
}

// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
