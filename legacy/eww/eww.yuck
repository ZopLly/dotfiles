;; ============================================
;; 1. ПЕРЕМЕННЫЕ
;; ============================================
;; Переменные Центра управления (Quick Settings)
(defpoll volume     :run-while open_cc :interval "1s" "pamixer --get-volume 2>/dev/null || echo 50")
(defpoll brightness :run-while open_cc :interval "1s" "brightnessctl -m | cut -d, -f4 | tr -d '%' 2>/dev/null || echo 50")
(defvar open_cc false)
(defvar media_open false)

;; Переменные Плеера (Media Popup)
(defpoll track_title   :run-while media_open :interval "1s" "playerctl metadata --format '{{ title }}' 2>/dev/null || echo 'Нет музыки'")
(defpoll track_artist  :run-while media_open :interval "1s" "playerctl metadata --format '{{ artist }}' 2>/dev/null || echo 'Остановлено'")
(defpoll play_status   :run-while media_open :interval "1s" "playerctl status 2>/dev/null || echo 'Paused'")
(defpoll cover_art     :run-while media_open :interval "1s" "/home/andrew/dotfiles/niri-staging/eww/scripts/get-cover.sh")

;; Время и позиция трека
(defpoll song_pos      :run-while media_open :interval "1s" "playerctl position 2>/dev/null | awk '{print int($1); found=1} END {if (!found) print 0}'")
(defpoll song_length   :run-while media_open :interval "1s" "playerctl metadata mpris:length 2>/dev/null | awk '{print int($1/1000000); found=1} END {if (!found) print 100}'")
(defpoll song_pos_fmt  :run-while media_open :interval "1s" "playerctl position --format '{{ duration(position) }}' 2>/dev/null || echo '0:00'")
(defpoll song_len_fmt  :run-while media_open :interval "1s" "playerctl metadata --format '{{ duration(mpris:length) }}' 2>/dev/null || echo '0:00'")


;; ============================================
;; 2. ВИДЖЕТ БЫСТРЫХ НАСТРОЕК (CONTROL CENTER)
;; ============================================
(defwidget control_center_widget []
  (revealer :transition "slidedown"
            :reveal open_cc
            :duration "350ms"
    (box :class "control-center-box"
         :orientation "v"
         :space-evenly false
         :spacing 12

      ;; Быстрые переключатели
      (box :class "quick-settings-row"
           :orientation "h"
           :space-evenly true
           :spacing 10
        (button :class "btn-tile wifi" :onclick "nm-connection-editor &"
          (box :orientation "h" :space-evenly false :spacing 8 :halign "center"
            (label :class "icon" :text "󰖩")
            (label :text "Wi-Fi")))
        (button :class "btn-tile bluetooth" :onclick "blueman-manager &"
          (box :orientation "h" :space-evenly false :spacing 8 :halign "center"
            (label :class "icon" :text "󰂯")
            (label :text "Bluetooth")))
      )

      ;; Слайдер Яркости
      (box :class "slider-row" :orientation "h" :space-evenly false :spacing 10
        (label :class "slider-icon" :text "󰃠")
        (scale :class "app-slider"
               :min 10
               :max 100
               :value brightness
               :onchange "brightnessctl set {}%")
      )

      ;; Слайдер Громкости
      (box :class "slider-row" :orientation "h" :space-evenly false :spacing 10
        (label :class "slider-icon" :text "󰕾")
        (scale :class "app-slider"
               :min 0
               :max 100
               :value volume
               :onchange "pamixer --set-volume {}")
      )

      ;; Кнопки питания
      (box :class "power-row" :orientation "h" :space-evenly true :spacing 8
        (button :class "btn-power lock" :onclick "/home/andrew/dotfiles/niri-staging/gtklock/scripts/lock.sh &" "󰌾")
        (button :class "btn-power reboot" :onclick "systemctl reboot" "󰜉")
        (button :class "btn-power shutdown" :onclick "systemctl poweroff" "󰐥")
      )
    )
  )
)


;; ============================================
;; 3. ВИДЖЕТ МЕДИА-ПЛЕЕРА (MEDIA POPUP)
;; ============================================
(defwidget media_popup_widget []
  (revealer :transition "slidedown"
            :reveal media_open
            :duration "350ms"
    (box :class "media-popup-box"
         :orientation "v"
         :space-evenly false
         :spacing 10

      ;; 1. Крупная обложка по центру
      (box :class "cover-art-container"
           :halign "center"
        (image :class "cover-art"
               :path cover_art
               :image-width 180
               :image-height 180)
      )

      ;; 2. Название песни и исполнитель
      (box :orientation "v" :space-evenly false :halign "center" :spacing 2
        (label :class "media-title" :limit-width 24 :text track_title)
        (label :class "media-artist" :limit-width 28 :text track_artist)
      )

      ;; 3. Ползунок времени (Seekbar)
      (box :class "timeline-box" :orientation "v" :space-evenly false :spacing 2
        (scale :class "song-slider"
               :min 0
               :max song_length
               :value song_pos
               :onchange "playerctl position {}")

        (box :orientation "h" :space-evenly true
          (label :class "time-label" :halign "start" :text song_pos_fmt)
          (label :class "time-label" :halign "end" :text song_len_fmt)
        )
      )

      ;; 4. Минималистичные кнопки управления
      (box :class "media-controls-minimal"
           :orientation "h"
           :space-evenly false
           :halign "center"
           :spacing 16
        (button :class "media-btn-min" :onclick "playerctl previous" "󰒮")
        (button :class "media-btn-min play-min"
                :onclick "playerctl play-pause"
                {play_status == "Playing" ? "󰏤" : "󰐊"})
        (button :class "media-btn-min" :onclick "playerctl next" "󰒭")
      )
    )
  )
)


;; ============================================
;; 4. ОПИСАНИЕ ОКОН (WINDOWS)
;; ============================================
;; Окно Быстрых Настроек
(defwindow control_center
  :monitor 0
  :geometry (geometry :x "10px"
                      :y "8px"
                      :width "340px"
                      :anchor "top right")
  :stacking "fg"
  (control_center_widget)
)

;; Окно Плеера
(defwindow media_popup
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "8px"
                      :width "320px"
                      :anchor "top center")
  :stacking "fg"
  (media_popup_widget)
)

;; Прозрачная подложка для закрытия по клику
(defwindow closer
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "100%")
  :stacking "fg"
  :focusable false
  (eventbox
    :onclick "eww --config /home/andrew/dotfiles/niri-staging/eww update open_cc=false media_open=false; eww --config /home/andrew/dotfiles/niri-staging/eww close control_center media_popup closer"
    (box :style "background: transparent;")
  )
)
