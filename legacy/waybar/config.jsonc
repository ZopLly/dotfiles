{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/launcher",
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
        "clock",
	"mpris",
	"custom/cava"
    ],

    "modules-right": [
	"tray",
	"niri/language",
	"wireplumber",
        "battery",
	"custom/quicksettings",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "fuzzel"
    },
    // Звук
    "wireplumber": {
	    "format": "{icon} {volume}%",
	    "format-muted": "󰝟 Mute",
	    "format-icons": ["󰕿", "󰖀", "󰕾"],
	    "on-click": "pavucontrol"
    },
    // 3. Играющая песня / видео (MPRIS)
    "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "󰏤 <i>{title}</i>",
    "player-icons": {
        "default": "󰎈",
        "spotify": "󰓇",
        "firefox": "󰈹",
        "chromium": "󰊯",
        "mpv": "󰐍"
    },
    "max-length": 30,
    "interval": 1,
    "on-click": "/home/andrew/dotfiles/niri-staging/eww/scripts/toggle-win.sh media_popup" // <-- Вызов отдельного окна плеера
},

    // 4. Эквалайзер CAVA
    "custom/cava": {
	    "exec": "/home/andrew/dotfiles/niri-staging/waybar/scripts/cava.sh",
	    "format": "{}"
    },
    // 5. Быстрая настройка
    "custom/quicksettings": {
	    "format": "󰍜",
	    "tooltip": false,
	    "on-click": "/home/andrew/dotfiles/niri-staging/eww/scripts/toggle-win.sh control_center"
    },


    "niri/language": {
        "format": "{}",
        "format-en": "en",
        "format-ru": "ru"
    },
    "niri/window": {
        "format": "{}",
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	"on-click": "gsimplecal"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁽", "󰁞", "󰁿", "󰂁", "󰂂", "󰁹"]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 12
    },

    // Конфигурация кнопки питания в углу
    "custom/power": {
        "format": "󰐥", // если используешь Nerd Fonts
        "tooltip": false,
        "on-click": "/home/andrew/dotfiles/niri-staging/waybar/scripts/power-menu.sh"// При клике открывается красивое меню
    }
}
