;; Переменные 
(defpoll volume :interval "1s" "pamixer --get-volume 2>/dev/null || echo 50")
(defpoll brightness :interval "1s" "brightnessctl -m | cut -d, -f4 | tr -d '%' 2>/dev/null || echo 50")
(defpoll track_title :interval "1s" "playerctl metadata --format '{{ title }}' 2>/dev/null || echo 'Нет музыки'")
(defpoll track_artist :interval "1s" "playerctl metadata --format '{{ artist }}' 2>/dev/null || echo 'Остановлено'")

;; Главный виджет шторки
(defwidget control_center_widget []
  (box :class "control-center-box"
       :orientation "v"
       :space-evenly false
       :spacing 12

    ;; 1. Быстрые переключатели
    (box :class "quick-settings-row"
         :orientation "h"
         :space-evenly true
         :spacing 10
      (button :class "btn-tile wifi" :onclick "nm-connection-editor &"
        (box :orientation "h" :space-evenly false :spacing 8 :halign "center"
          (label :class "icon" :text "󰖩")
          (label :text "Wi-Fi")))
      (button :class "btn-tile bluetooth" :onclick "blueman-manager &"
        (box :orientation "h" :space-evenly false :spacing 8 :halign "center"
          (label :class "icon" :text "󰂯")
          (label :text "Bluetooth")))
    )

    ;; 2. Слайдер Яркости
    (box :class "slider-row" :orientation "h" :space-evenly false :spacing 10
      (label :class "slider-icon" :text "󰃠")
      (scale :class "app-slider"
             :min 10
             :max 100
             :value brightness
             :onchange "brightnessctl set {}%")
    )

    ;; 3. Слайдер Громкости
    (box :class "slider-row" :orientation "h" :space-evenly false :spacing 10
      (label :class "slider-icon" :text "󰕾")
      (scale :class "app-slider"
             :min 0
             :max 100
             :value volume
             :onchange "pamixer --set-volume {}")
    )

    ;; 4. Плеер
    (box :class "media-card" :orientation "v" :space-evenly false :spacing 8
      (box :orientation "v" :space-evenly false :halign "center"
        (label :class "track-title" :limit-width 25 :text track_title)
        (label :class "track-artist" :limit-width 30 :text track_artist)
      )
      (box :class "media-controls" :orientation "h" :space-evenly true
        (button :class "media-btn" :onclick "playerctl previous" "󰒮")
        (button :class "media-btn play" :onclick "playerctl play-pause" "󰐊")
        (button :class "media-btn" :onclick "playerctl next" "󰒭")
      )
    )

    ;; 5. Кнопки питания
    (box :class "power-row" :orientation "h" :space-evenly true :spacing 8
      (button :class "btn-power lock" :onclick "swaylock &" "󰌾")
      (button :class "btn-power reboot" :onclick "systemctl reboot" "󰜉")
      (button :class "btn-power shutdown" :onclick "systemctl poweroff" "󰐥")
    )
  )
)

;; Окно
(defwindow control_center
  :monitor 0
  :geometry (geometry :x "10px"
                      :y "50px"
                      :width "340px"
                      :anchor "top right")
  :stacking "fg"
  (control_center_widget)
)
